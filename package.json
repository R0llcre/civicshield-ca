{
  "name": "regshield-ca",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "start": "npm -w apps/web run start",
    "lint": "npm -w apps/web run lint",
    "typecheck": "npm -w apps/web run typecheck",
    "i18n:check": "npm -w apps/web run i18n:check",
    "test": "npm -w apps/web run test",
    "test:e2e": "npm -w apps/web run test:e2e",
    "etl:test": "python3 -m pip install -r etl/requirements.txt && python3 -m pytest -q etl/tests",
    "etl:run": "python3 etl/ra_roster_etl.py",
    "partner:provision": "node scripts/provision_partner.mjs",
    "smoke:api": "node scripts/smoke_api.mjs",
    "preflight:staging": "node scripts/smoke_api.mjs --require-supabase --max-ra-age-hours 48",
    "fixtures:vault": "node scripts/generate_vault_fixtures.mjs",
    "android:dev:assemble": "bash scripts/android_dev_run.sh assemble",
    "android:dev:install": "bash scripts/android_dev_run.sh install",
    "android:dev:clean-assemble": "bash scripts/android_dev_run.sh clean-assemble",
    "android:dev:up": "bash scripts/android_dev_up.sh",
    "android:dev:down": "bash scripts/android_dev_down.sh",
    "android:dev:status": "bash scripts/android_dev_status.sh",
    "android:staging:assemble": "bash scripts/android_staging_run.sh assemble",
    "android:staging:install": "bash scripts/android_staging_run.sh install",
    "android:staging:clean-assemble": "bash scripts/android_staging_run.sh clean-assemble",
    "android:staging:up": "bash scripts/android_staging_up.sh",
    "android:staging:down": "bash scripts/android_staging_down.sh",
    "android:staging:status": "bash scripts/android_staging_status.sh",
    "ios:staging:up": "bash scripts/ios_staging_up.sh"
  }
}
