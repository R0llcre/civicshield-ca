{
  "name": "regshield-ca",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "start": "npm -w apps/web run start",
    "lint": "npm -w apps/web run lint",
    "typecheck": "npm -w apps/web run typecheck",
    "test": "npm -w apps/web run test",
    "test:e2e": "npm -w apps/web run test:e2e",
    "etl:test": "python3 -m pip install -r etl/requirements.txt && python3 -m pytest -q etl/tests",
    "etl:run": "python3 etl/ra_roster_etl.py"
  }
}
